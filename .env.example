# Paths only. Credentials stay inside the existing ignored settings file.
# Start with an isolated test database and console email backend.
NAKITIN_SETTINGS_FILE=/absolute/path/to/staging/settings.py
NAKITIN_SECRET_FILE=/absolute/path/to/staging/secret_key.txt
NAKITIN_BIND_IP=127.0.0.1
NAKITIN_PORT=8001
# On Linux, use the numeric owner/group of the mounted configuration files.
# Obtain the production account IDs with: id -u django; id -g django
NAKITIN_UID=10001
NAKITIN_GID=10001
